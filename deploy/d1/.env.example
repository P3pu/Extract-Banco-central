# Exemplo APENAS de parâmetros não secretos. Não colocar senhas aqui.
# Copiar para /etc/bcd-d1/compose.env somente após diagnóstico e aprovação.
D1_ENABLE_INCREMENTALS=no
D1_SECRET_DIR=/etc/bcd-d1/secrets
POSTGRES_HOST=UNSET
POSTGRES_PORT=UNSET
POSTGRES_USER=UNSET
POSTGRES_SSLMODE=verify-full
MAGENTO_MYSQL_HOST=UNSET
MAGENTO_MYSQL_PORT=3306
MAGENTO_MYSQL_DATABASE=UNSET
MAGENTO_MYSQL_USER=UNSET
ATIVO_MYSQL_HOST=UNSET
ATIVO_MYSQL_PORT=3306
ATIVO_MYSQL_DATABASE=UNSET
ATIVO_MYSQL_USER=UNSET
BATCH_SIZE=10000
RECONCILIATION_DAYS=30
CONNECT_TIMEOUT=10
