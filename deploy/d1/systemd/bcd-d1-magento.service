[Unit]
Description=Banco Central D1 Magento incremental (primeira onda)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
StateDirectory=bcd-d1
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/bcd-d1
WorkingDirectory=/opt/extract-banco-central
ExecStart=/bin/sh /opt/extract-banco-central/deploy/d1/run_incrementals.sh magento
TimeoutStartSec=12h
StandardOutput=journal
StandardError=journal
